# Copy to .env.local (git ignores it) and adjust.

# Live Knowledge Base API, including /api/v1. Defaults to staging when unset.
VITE_KB_API_BASE_URL=https://stag-pgm-mgmt-api.thriwe.com/api/v1

# Backend to start with: live (default) or mock (in-memory, sample data).
# The Mock / Live switch in the editor overrides this per browser.
VITE_KB_API_MODE=live

# In development, live calls go through the dev server's /kb-api proxy, because
# the API sends no CORS headers for localhost. Set to off to call
# VITE_KB_API_BASE_URL directly instead (only works once the API allows
# http://localhost:5173). Restart npm run dev after changing it.
# VITE_KB_API_DEV_PROXY=off

# Session token for local development only (sent as "Authorization: Bearer <token>";
# ignored in production builds). Never commit a real token: put it in .env.local.
VITE_KB_TOKEN=
