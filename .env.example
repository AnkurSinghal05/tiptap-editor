# Knowledge Base API base URL, including /api/v1. Placeholder: replace with the
# real host. Leave unset to use the in-memory mock backend.
VITE_KB_API_BASE_URL=https://kb-api.example.com/api/v1

# Session token for local development only (sent as "Authorization: Bearer <token>";
# ignored in production builds). Never commit a real token: put it in .env.local.
VITE_KB_TOKEN=
