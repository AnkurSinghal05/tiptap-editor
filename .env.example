# Copy to .env.local (git ignores it) and adjust.

# Live Knowledge Base API, including /api/v1. Defaults to staging when unset.
VITE_KB_API_BASE_URL=https://stag-pgm-mgmt-api.thriwe.com/api/v1

# Backend to start with: live (default) or mock (in-memory, sample data).
# The Mock / Live switch in the editor overrides this per browser.
VITE_KB_API_MODE=live

# Live calls go to /kb-api on the app's own server, which forwards them: the
# dev server in development, api/kb-proxy.ts on Vercel (set it to on there).
# Defaults: on in development (the API sends no CORS headers for localhost),
# off in other builds, which call VITE_KB_API_BASE_URL directly. off in
# development only works once the API allows http://localhost:5173.
# Restart npm run dev after changing it. (Old name: VITE_KB_API_DEV_PROXY.)
# VITE_KB_API_PROXY=off

# On Vercel only (server side, read by api/kb-proxy.ts; see README):
#   KB_API_TOKEN          Secret: the token the function sends to the API
#   KB_API_PROJECT_CODES  optional, defaults to THRIWE_APP

# Session token for local development only (sent as "Authorization: Bearer <token>";
# ignored in production builds). Never commit a real token: put it in .env.local.
VITE_KB_TOKEN=
